# Existing app authentication/storage
DATABASE_URL=postgres://user:password@host/database

# Master Tracker: server-side only, never exposed to the browser.
# Optional overrides. Empty uses built-in financial fetching and internal Python research.
SCREENER_MCP_URL=
SCREENER_MCP_TOKEN=
# Local/container alternative: installed MCP executable and its JSON argument array.
SCREENER_MCP_COMMAND=
SCREENER_MCP_ARGS=[]
CONCALL_SERVICE_URL=
CONCALL_SERVICE_TOKEN=
OPEN_AI_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Alternative provider, used only when no OpenAI key is configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Local test harness only. Keep false for ordinary development and deployment.
MASTER_TRACKER_TEST_MODE=false

# Announcement alerts (Web Push). Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# /api/cron/announcements (called every minute by cron-job.org) needs: Authorization: Bearer $CRON_SECRET
CRON_SECRET=
